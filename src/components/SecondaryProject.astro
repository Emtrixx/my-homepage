---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const external = (href: string) => href.startsWith('http');
---

<article class="grid gap-x-8 gap-y-3 border-t border-edge py-6 md:grid-cols-[1fr_2fr]">
  <h3 class="text-lg text-ink">{project.name}</h3>

  <div>
    <p class="leading-relaxed text-dust">{project.summary}</p>

    <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
      {project.tags.map((tag) => <span class="tag">{tag}</span>)}

      {
        project.links.map((link) => (
          <a
            href={link.href}
            class="prose-link font-mono text-xs tracking-[0.08em] uppercase"
            {...external(link.href) ? { target: '_blank', rel: 'noreferrer' } : {}}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</article>
