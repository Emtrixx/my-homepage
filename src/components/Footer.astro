  >
    <p class="eyebrow">© {year} Jesse Günzl · Hamburg</p>

    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <li>
        <a class="eyebrow hover:text-ink" href="https://github.com/Emtrixx" rel="noreferrer" target="_blank">
          GitHub
        </a>
      </li>
      <li>
        <a class="eyebrow hover:text-ink" href="mailto:contact@jesseguenzl.com">Email</a>
      </li>
      <li>
        <a class="eyebrow hover:text-ink" href="/impressum/">Impressum &amp; Datenschutz</a>
      </li>
    </ul>
  </div>
</footer>
