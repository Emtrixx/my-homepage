---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Alternate the image side so the eye zig-zags down the column. */
  flip: boolean;
}

const { project, flip } = Astro.props;
const external = (href: string) => href.startsWith('http');
---

<article class="grid items-center gap-6 sm:gap-10 md:grid-cols-2">
  {
    project.image && (
      <div class={`surface overflow-hidden ${flip ? 'md:order-2' : ''}`}>
        {/* Two of these are logos on white. Left raw they punch a hole in the
            page; the filter pulls them toward the stock tone without washing out
            the raytracer render, which is already dark. */}
        <img
          src={project.image}
          alt={project.alt ?? ''}
          width="640"
          height="400"
          loading="lazy"
          decoding="async"
          class="h-56 w-full object-cover opacity-[0.88] saturate-[0.85] contrast-[1.05] sm:h-72"
        />
      </div>
    )
  }

  <div class={flip ? 'md:order-1' : ''}>
    <h3 class="text-2xl sm:text-3xl" style="font-stretch: 105%;">{project.name}</h3>

    <p class="mt-3 text-lg leading-snug text-ink">{project.summary}</p>
    {project.detail && <p class="mt-3 leading-relaxed text-dust">{project.detail}</p>}

    <ul class="mt-5 flex flex-wrap gap-2">
      {project.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>

    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
      {
        project.links.map((link) => (
          <a
            href={link.href}
            class="prose-link font-mono text-xs tracking-[0.08em] uppercase"
            {...external(link.href) ? { target: '_blank', rel: 'noreferrer' } : {}}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</article>
