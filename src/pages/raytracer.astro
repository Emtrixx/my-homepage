---
import Base from '../layouts/Base.astro';
---

<Base
  title="Raytracer — Jesse Günzl"
  description="A real-time raytracer running in the browser. Written in Rust, compiled to WebAssembly."
>
  <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
    <p class="eyebrow">Rust · WebAssembly</p>
    <h1 class="mt-3" style="font-size: var(--text-section);">Raytracer</h1>

    <p class="mt-4 max-w-xl leading-relaxed text-dust">
      Move with <kbd class="tag">W</kbd> <kbd class="tag">A</kbd> <kbd class="tag">S</kbd>
      <kbd class="tag">D</kbd>, up and down with <kbd class="tag">Q</kbd> <kbd class="tag">E</kbd>,
      brightness with <kbd class="tag">Z</kbd> <kbd class="tag">X</kbd>. Every pixel is a ray, every
      frame.
    </p>

    <div class="surface mt-8 overflow-x-auto p-3">
      <canvas id="raytracerwasm-canvas" width="600" height="400" class="mx-auto block"></canvas>
    </div>

    <!-- The bundle grabs this with querySelector('form'); it must be the first form. -->
    <form class="mt-8 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-3">
      <label class="flex flex-col gap-1">
        <span class="eyebrow">Width</span>
        <input id="width" name="width" type="number" value="600" class="field" />
      </label>
      <label class="flex flex-col gap-1">
        <span class="eyebrow">Height</span>
        <input id="height" name="height" type="number" value="400" class="field" />
      </label>

      <label class="col-span-2 flex flex-col gap-1 sm:col-span-1">
        <span class="eyebrow">Brightness <span id="brightness-value" class="text-ink">1</span></span>
        <input id="brightness" name="brightness" type="range" min="0" max="4" step="0.1" value="1" class="mt-2 accent-rust" />
      </label>

      <button
        type="submit"
        class="col-span-2 mt-2 justify-self-start border border-edge bg-deep px-5 py-2 font-mono text-xs uppercase tracking-[0.12em] text-ink transition-colors hover:border-phosphor hover:text-phosphor sm:col-span-3"
      >
        Render
      </button>
    </form>

    <p class="mt-10">
      <a class="prose-link font-mono text-xs uppercase tracking-[0.08em]" href="https://github.com/Emtrixx/raytracer_wasm" rel="noreferrer" target="_blank">
        Source
      </a>
    </p>
  </div>

  <!-- webpack 5: derives its public path from document.currentScript.src, so no <base> needed. -->
  <script is:inline src="/raytracer/bootstrap.js"></script>
</Base>

<style>
  .field {
    background-color: var(--color-void);
    border: 1px solid var(--color-edge);
    border-radius: 2px;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .field:focus {
    border-color: var(--color-phosphor);
  }
</style>
