---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Jesse Günzl" noindex={true}>
  <div class="mx-auto flex max-w-5xl flex-col justify-center px-5 py-32 sm:px-8">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3" style="font-size: var(--text-hero); line-height: 0.9; font-stretch: 112%; font-weight: 800;">
      404
    </h1>
    <p class="lede mt-6 max-w-md text-dust">
      Nothing at this address. It may have moved, or it may never have existed.
    </p>
    <p class="mt-8">
      <a href="/" class="prose-link font-mono text-xs uppercase tracking-[0.08em]">Back to the start</a>
    </p>
  </div>
</Base>
